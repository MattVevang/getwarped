{
  "name": "getwarped",
  "version": "1.0.0",
  "description": "GetWarped: Secure Multi-Service Workspace App - A secure desktop application for managing multiple online services in isolated workspaces",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "webpack --config webpack.main.config.js --mode=production",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode=production",
    "build:dev": "npm run build:main:dev && npm run build:renderer:dev",
    "build:main:dev": "webpack --config webpack.main.config.js --mode=development",
    "build:renderer:dev": "webpack --config webpack.renderer.config.js --mode=development",
    "build:watch": "npm run build:main:watch & npm run build:renderer:watch",
    "build:main:watch": "webpack --config webpack.main.config.js --mode=development --watch",
    "build:renderer:watch": "webpack --config webpack.renderer.config.js --mode=development --watch",
    "start": "electron dist/main/main.js",
    "dev": "npm run build:dev && npm run start",
    "dev:watch": "concurrently \"npm run build:main:watch\" \"npm run build:renderer:watch\" \"wait-on dist/main/main.js && electron dist/main/main.js\"",
    "dev:renderer": "webpack serve --config webpack.renderer.config.js --mode=development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:integration": "jest --testMatch=\"**/?(*.)+(integration|itest).+(ts|js)\"",
    "test:unit": "jest --testMatch=\"**/?(*.)+(spec|test).+(ts|js)\" --testPathIgnorePatterns=\"**/?(*.)+(integration|itest).+(ts|js)\"",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "security:scan": "npm audit",
    "security:fix": "npm audit fix",
    "config:export": "node scripts/export-config.js",
    "config:import": "node scripts/import-config.js",
    "config:backup": "node scripts/backup-config.js",
    "prepare": "husky install",
    "package": "electron-builder",
    "package:win": "electron-builder --win",
    "package:mac": "electron-builder --mac",
    "package:linux": "electron-builder --linux",
    "clean": "rimraf dist",
    "clean:all": "rimraf dist node_modules && npm install",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "electron",
    "typescript",
    "react",
    "secure",
    "workspace",
    "multi-service",
    "privacy",
    "isolation"
  ],
  "author": "GetWarped Team",
  "license": "MIT",
  "homepage": "https://github.com/yourusername/getwarped#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/getwarped.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/getwarped/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^18.19.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^8.2.2",
    "css-loader": "^7.1.2",
    "electron": "^27.3.0",
    "electron-builder": "^24.13.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "html-webpack-plugin": "^5.6.4",
    "husky": "^8.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.1.2",
    "jsdom": "^27.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.5",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.4.0",
    "wait-on": "^7.2.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.0",
    "@types/uuid": "^10.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^2.1.1",
    "antd": "^5.15.0",
    "electron-log": "^5.0.1",
    "electron-store": "^8.2.0",
    "keytar": "^7.9.0",
    "react": "^18.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.50.0",
    "react-hot-toast": "^2.4.1",
    "react-redux": "^9.1.0",
    "react-router-dom": "^6.30.1",
    "redux-persist": "^6.0.0",
    "uuid": "^13.0.0"
  },
  "build": {
    "appId": "com.getwarped.app",
    "productName": "GetWarped",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "type": "distribution"
    },
    "win": {
      "target": "nsis",
      "publisherName": "GetWarped Team"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
